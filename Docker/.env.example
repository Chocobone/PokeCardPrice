# 이 파일을 .env로 복사해 사용한다. .env는 커밋하지 않는다.
POSTGRES_USER=cardmarket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cardmarket

# 호스트에 노출할 포트
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# 수집기를 매일 일정 대신 이 간격으로 실행 (개발용, 예: 30s). 비우면 매일 05:30 KST
COLLECTOR_INTERVAL=

# 카탈로그 수집 범위 (개발용, 비우면 전체). 예: CATALOG_LANGUAGES=en,ja / CATALOG_SETS=sv03.5,SV5K
CATALOG_LANGUAGES=
CATALOG_SETS=
# true 면 매 실행을 전체 갱신(모든 카드 상세 재조회)으로 한다. 비우면 매월 1일 일정 실행만 전체 갱신
CATALOG_FULL=

# 수집기만 다른 장비에서 돌리고 DB 는 원격에 둘 때 지정 (scripts/collector.sh). 비우면 이 compose 의 db 를 쓴다
# 예: postgres://cardmarket:비밀번호@192.168.0.10:5432/cardmarket?sslmode=disable
COLLECTOR_DATABASE_URL=
